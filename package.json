{
  "name": "odorokinews",
  "version": "0.1.0",
  "private": true,
  "description": "モーゼン・アングラを舞台とした架空世界ニュースシミュレーションシステム",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrations:apply:local": "wrangler d1 migrations apply odorokinews-db --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply odorokinews-db --remote",
    "db:seed:local": "wrangler d1 execute odorokinews-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute odorokinews-db --remote --file=./seed.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hono": "^4.6.0"
  }
}
