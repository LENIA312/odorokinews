{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "odorokinews",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // 10分おきに「配信すべき時刻か」をチェックするだけのCron。
  // 実際の配信時刻(JST)はDB側(world.auto_publish_times)で管理し、
  // 管理画面から再デプロイなしに変更できるようにしている。
  // 1回の配信につき世界の日付が1日進む。
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // D1: `wrangler d1 create odorokinews-db` を実行し、
  // 出力された database_id を下記に設定してください。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odorokinews-db",
      "database_id": "33385610-d9d0-4dd6-86d2-fd6405fb5d04",
      "migrations_dir": "./migrations"
    }
  ],

  // Workers AI（常にリモート実行）
  "ai": {
    "binding": "AI"
  },

  // モデル名・上限値はコードにハードコードせず、ここで管理する。
  // 将来モデルが変わった場合はここだけを書き換えれば良い。
  "vars": {
    "ENVIRONMENT": "production",
    "AI_EVENT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "AI_NEWS_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "AI_MAX_CALLS_PER_RUN": "4"
  }

  // ADMIN_TOKEN（手動シミュレーション実行用のシークレット）は
  // `wrangler secret put ADMIN_TOKEN` で設定してください（任意）。
}
