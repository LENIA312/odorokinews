{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "odorokinews",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // 2本のCronを併用する（index.tsのscheduled()内でevent.cronの値により処理を振り分ける）。
  // - "*/10 * * * *": 10分おきに「配信すべき時刻か」をチェックするだけ。実際の配信時刻(JST)は
  //   DB側(world.auto_publish_times)で管理し、管理画面から再デプロイなしに変更できる。
  //   1回の配信につき世界の日付が1日進む。
  // - "0 23 * * *": 毎日08:00 JST(=23:00 UTC)に、前日分のニュースをXへ日次まとめ投稿する。
  "triggers": {
    "crons": ["*/10 * * * *", "0 23 * * *"]
  },

  // D1: `wrangler d1 create odorokinews-db` を実行し、
  // 出力された database_id を下記に設定してください。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odorokinews-db",
      "database_id": "33385610-d9d0-4dd6-86d2-fd6405fb5d04",
      "migrations_dir": "./migrations"
    }
  ],

  // Workers AI（常にリモート実行）
  "ai": {
    "binding": "AI"
  },

  // モデル名・上限値はコードにハードコードせず、ここで管理する。
  // 将来モデルが変わった場合はここだけを書き換えれば良い。
  "vars": {
    "ENVIRONMENT": "production",
    "AI_EVENT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "AI_NEWS_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "AI_MAX_CALLS_PER_RUN": "4"
  }

  // ADMIN_TOKEN（手動シミュレーション実行用のシークレット）は
  // `wrangler secret put ADMIN_TOKEN` で設定してください（任意）。
  //
  // X(旧Twitter)への日次まとめ投稿を使う場合、以下4つも
  // `wrangler secret put <name>` で設定してください（任意・4つ揃わないと投稿はスキップされる）。
  // X_API_KEY / X_API_KEY_SECRET / X_ACCESS_TOKEN / X_ACCESS_TOKEN_SECRET
}
